OPENROUTER_API_KEY=
# Optional overrides for the nightly generator (these are the defaults).
# GENERATOR_MODEL=google/gemini-3.6-flash
# VERIFIER_MODEL=openai/gpt-5.4-mini

# Supabase (production). docker compose ignores this and always uses its own local Postgres. See supabase/README.md.
# Transaction pooler URI from the dashboard's Connect panel, with sslmode=require. Server-side only, never in web/.
# DATABASE_URL=
# Only used by supabase/verify.sh to prove the public REST API can't read the game tables.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Review bot (python -m rarest_blue.entrypoints.discord_bot). See supabase/README.md for setting up the Discord app.
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# A private channel: the bot posts every answer there.
# DISCORD_REVIEW_CHANNEL_ID=
# Members with this role can apply suggestions (so can anyone with Manage Server).
# DISCORD_REVIEWER_ROLE_ID=
